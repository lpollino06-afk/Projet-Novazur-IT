# Configuration Apache (OVH, o2switch, Hostinger, IONOS…)

# Page 404 personnalisée
ErrorDocument 404 /404.html

# MultiViews (actif par défaut chez OVH) ajoute tout seul le .html et fausse les règles ci-dessous
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html -> /  (évite le contenu dupliqué)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.novazur-it.com/ [L,R=301]

  # URLs sans .html : /contact.html -> /contact (redirection 301 des anciennes adresses)
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://www.novazur-it.com/%1 [L,R=301]

  # /contact/ -> /contact (une seule version de chaque page)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://www.novazur-it.com/$1 [L,R=301]

  # Forcer HTTPS + www (une seule version du site pour Google)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.novazur-it.com/$1 [L,R=301]

  # /contact sert le fichier contact.html (END : pas de second passage dans les règles)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [END]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
